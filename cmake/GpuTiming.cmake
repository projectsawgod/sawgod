# SDL GPU staging reuse and timestamps use private copies of dependency translation units;
# upstream/ref sources remain untouched. All extension code lives in this project.
if(NOT SAWGOD_SYSTEM_SDL)
    get_target_property(gpu_timing_sources SDL3-static SOURCES)
    set(gpu_timing_updated "")
    set(gpu_timing_vulkan OFF)
    set(gpu_timing_renderer OFF)
    foreach(gpu_timing_source IN LISTS gpu_timing_sources)
        if(gpu_timing_source MATCHES "src/gpu/vulkan/SDL_gpu_vulkan.c$")
            set(gpu_timing_vulkan ON)
            file(READ "${gpu_timing_source}" gpu_timing_text)
            string(REPLACE "// Command Buffers" "#include \"${CMAKE_SOURCE_DIR}/src/engine/gpu_pipeline_cache_vulkan.inc\"\n// Command Buffers" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "        renderer->logicalDevice,\n        VK_NULL_HANDLE,\n        1,\n        &vkPipelineCreateInfo," "        renderer->logicalDevice,\n        SawGodPipelineCacheGet(renderer),\n        1,\n        &vkPipelineCreateInfo," gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "// Command Buffers" "#include \"${CMAKE_SOURCE_DIR}/src/engine/gpu_timing_vulkan.inc\"\n// Command Buffers" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "VkResult result = renderer->vkEndCommandBuffer(" "SawGodTimingEnd(renderer, commandBuffer);\n    VkResult result = renderer->vkEndCommandBuffer(" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "// Present, if applicable" "SawGodTimingSubmitted(renderer, vulkanCommandBuffer);\n    // Present, if applicable" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "VULKAN_Wait(device->driverData);" "VULKAN_Wait(device->driverData);\n    SawGodTimingDestroy(renderer);\n    SawGodPipelineCacheDestroy(renderer);" gpu_timing_text "${gpu_timing_text}")
            # Opt-in CPU attribution of driver pipeline compilation, separate from GPU timestamps.
            string(REPLACE "    // TODO: enable pipeline caching" "    const Uint64 sawgod_pipeline_start = SDL_GetTicksNS();\n    // TODO: enable pipeline caching" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "        &graphicsPipeline->pipeline);" "        &graphicsPipeline->pipeline);\n    if (SDL_getenv(\"SAWGOD_GPU_CPU_TIMING\")) SDL_Log(\"GPU CPU pipeline t=%.3f cost=%.3f ms shader=%p blend=%d format=%d\", (double)SDL_GetTicksNS()/1e6, (double)(SDL_GetTicksNS()-sawgod_pipeline_start)/1e6, (void *)createinfo->fragment_shader, (int)createinfo->target_info.color_target_descriptions[0].blend_state.enable_blend, (int)createinfo->target_info.color_target_descriptions[0].format);" gpu_timing_text "${gpu_timing_text}")
            file(WRITE "${CMAKE_BINARY_DIR}/SDL_gpu_vulkan_timing.c" "${gpu_timing_text}")
            list(APPEND gpu_timing_updated "${CMAKE_BINARY_DIR}/SDL_gpu_vulkan_timing.c")
        elseif(gpu_timing_source MATCHES "src/render/gpu/SDL_render_gpu.c$")
            set(gpu_timing_renderer ON)
            file(READ "${gpu_timing_source}" gpu_timing_text)
            string(REPLACE "#endif // SDL_VIDEO_RENDER_GPU" "#ifdef SAWGOD_GPU_TIMESTAMPS\n#include \"${CMAKE_SOURCE_DIR}/src/engine/gpu_timing_renderer.inc\"\n#endif\n#endif // SDL_VIDEO_RENDER_GPU" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "    bool external_device;" "    Uint64 sawgod_upload_bytes, sawgod_upload_calls, sawgod_upload_allocations;\n    bool external_device;" gpu_timing_text "${gpu_timing_text}")
            # Reuse texture-owned staging on every GPU backend; the dependency stays read-only.
            string(REPLACE "    SDL_Rect locked_rect;" "    SDL_GPUTransferBuffer *sawgod_upload;\n    Uint32 sawgod_upload_size;\n    SDL_Rect locked_rect;" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "static bool GPU_SupportsBlendMode(" "#include \"${CMAKE_SOURCE_DIR}/src/engine/gpu_upload_renderer.inc\"\nstatic bool GPU_SupportsBlendMode(" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "GPU_UpdateTextureInternal(GPU_RenderData *renderdata, SDL_GPUCopyPass *cpass," "GPU_UpdateTextureInternal(GPU_RenderData *renderdata, GPU_TextureData *data, SDL_GPUCopyPass *cpass," gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "GPU_UpdateTextureInternal(renderdata, cpass," "GPU_UpdateTextureInternal(renderdata, data, cpass," gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "    tex_src.rows_per_layer = h;" "    renderdata->sawgod_upload_bytes += data_size;\n    ++renderdata->sawgod_upload_calls;\n    tex_src.rows_per_layer = h;" gpu_timing_text "${gpu_timing_text}")
            # This allocation block occurs only in GPU_UpdateTextureInternal (the palette uses data->device).
            string(REPLACE "SDL_GPUTransferBuffer *tbuf = SDL_CreateGPUTransferBuffer(renderdata->device, &tbci);" "SDL_GPUTransferBuffer *tbuf = SawGodUploadBuffer(renderdata, data, tbci.size);" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "SDL_MapGPUTransferBuffer(renderdata->device, tbuf, false)" "SDL_MapGPUTransferBuffer(renderdata->device, tbuf, true)" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "    SDL_ReleaseGPUTransferBuffer(renderdata->device, tbuf);" "    // Texture-owned staging is released by GPU_DestroyTexture." gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "        // TODO allocate a persistent transfer buffer" "        if (!SawGodUploadBuffer(renderdata, data, (Uint32)size)) return false;" gpu_timing_text "${gpu_timing_text}")
            string(REPLACE "    SDL_free(data->pixels);" "    if (data->sawgod_upload) SDL_ReleaseGPUTransferBuffer(renderdata->device, data->sawgod_upload);\n    SDL_free(data->pixels);" gpu_timing_text "${gpu_timing_text}")
            file(WRITE "${CMAKE_BINARY_DIR}/SDL_render_gpu_timing.c" "${gpu_timing_text}")
            list(APPEND gpu_timing_updated "${CMAKE_BINARY_DIR}/SDL_render_gpu_timing.c")
        else()
            list(APPEND gpu_timing_updated "${gpu_timing_source}")
        endif()
    endforeach()
    if(gpu_timing_renderer)
        set_property(TARGET SDL3-static PROPERTY SOURCES "${gpu_timing_updated}")
        target_include_directories(SDL3-static PRIVATE "${sdl3_SOURCE_DIR}/src/gpu/vulkan" "${sdl3_SOURCE_DIR}/src/render/gpu")
        target_compile_definitions(SDL3-static PRIVATE SAWGOD_GPU_UPLOADS)
        add_compile_definitions(SAWGOD_GPU_UPLOADS)
        if(gpu_timing_vulkan)
            target_compile_definitions(SDL3-static PRIVATE SAWGOD_GPU_TIMESTAMPS)
            add_compile_definitions(SAWGOD_GPU_TIMESTAMPS)
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${CMAKE_SOURCE_DIR}/src/engine/gpu_pipeline_cache_vulkan.inc"
            "${CMAKE_SOURCE_DIR}/src/engine/gpu_timing_vulkan.inc"
            "${CMAKE_SOURCE_DIR}/src/engine/gpu_timing_renderer.inc"
            "${CMAKE_SOURCE_DIR}/src/engine/gpu_upload_renderer.inc")
    endif()
endif()
