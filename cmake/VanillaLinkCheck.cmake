# Check the complete target dependency graph, including transitive static dependencies.
function(sawgod_check_vanilla_link root)
    set(pending "${root}")
    set(visited "")
    while(pending)
        list(POP_FRONT pending item)
        if(item IN_LIST visited OR NOT TARGET "${item}")
            continue()
        endif()
        list(APPEND visited "${item}")
        if(item MATCHES "sawgod_ui|sawgod_imgui|sawgod_enhanced_music|[Ii][Mm][Gg][Uu][Ii]|enhanced.*renderer")
            message(FATAL_ERROR "${root} links excluded dependency ${item}")
        endif()
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(dependencies "${item}" "${property}")
            foreach(dependency IN LISTS dependencies)
                # CMake wraps private static dependencies in LINK_ONLY.
                string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" dependency "${dependency}")
                if(TARGET "${dependency}")
                    list(APPEND pending "${dependency}")
                endif()
            endforeach()
        endforeach()
    endwhile()
endfunction()
