# Third-party reference material, ROMs, BIOS: never committed
/ref/

# Scratch and build output
/tmp/
/docs/debug_logs/
/temp/
/build/
/out/
/dist/

# Local tool installs / environments
/tools/.venv/
/tools/ghidra/
__pycache__/
*.pyc

# Never commit game data or saves
*.wsc
*.ws
*.gb
*.gbc
*.sav
*.srm
*.o2r

# Renders (screenshots, audio) are ROM-derived: local only
/renders/

# Generated by the build
/assets/text/en.csv
/translation/.~lock.*#
/translation/*.pending.csv

# ROM-derived and personal working data (GB map work, translation backups); never committed
private/
.claude/

# LibreOffice lock files and FUSE leftovers (hold the local user name)
.~lock.*#
.fuse_hidden*
