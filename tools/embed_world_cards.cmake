# Authored PNGs ship inside the executable, like the splash logos. No Python/font needed.
set(content "// Generated world-card PNG bytes. Missing pictures are empty.\n")
set(entries "")
foreach(card RANGE 1 4)
    foreach(scale 1 8)
        set(path "${SOURCE_ROOT}/assets/ui/world_cards/world_card_${card}_${scale}x.png")
        set(bytes "")
        set(size 0)
        if(EXISTS "${path}")
            file(READ "${path}" hex HEX)
            string(LENGTH "${hex}" length)
            math(EXPR size "${length} / 2")
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        endif()
        string(APPEND content "constexpr unsigned char card_${card}_${scale}[] = {${bytes}0};\n")
        string(APPEND entries "{card_${card}_${scale}, ${size}},\n")
    endforeach()
endforeach()
string(APPEND content "constexpr Png cards[] = {\n${entries}};\n")

set(entries "")
foreach(card RANGE 1 4)
    foreach(scale 1 8)
        set(layout "")
        set(layout_path "${SOURCE_ROOT}/assets/ui/world_cards/world_card_${card}.json")
        if(EXISTS "${layout_path}")
            file(READ "${layout_path}" layout)
        endif()
        foreach(part RANGE 0 3)
            set(path "${SOURCE_ROOT}/assets/ui/world_cards/world_card_${card}_${scale}x_part${part}.png")
            set(bytes "")
            set(size 0)
            if(EXISTS "${path}" AND NOT layout STREQUAL "")
                file(READ "${path}" hex HEX)
                string(LENGTH "${hex}" length)
                math(EXPR size "${length} / 2")
                string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
            endif()
            set(box "")
            foreach(coord RANGE 0 3)
                set(value 0)
                if(NOT layout STREQUAL "")
                    string(JSON value GET "${layout}" "${scale}" ${part} ${coord})
                endif()
                string(APPEND box "${value},")
            endforeach()
            string(APPEND content "constexpr unsigned char part_${card}_${scale}_${part}[] = {${bytes}0};\n")
            string(APPEND entries "{{part_${card}_${scale}_${part}, ${size}}, {${box}}},\n")
        endforeach()
    endforeach()
endforeach()
string(APPEND content "constexpr BakedPart parts[] = {\n${entries}};\n")
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${content}" @ONLY)
